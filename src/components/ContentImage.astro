---
interface Props {
  path: string;
  width?: number | string;
  alt?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in template
const { path, width, alt = "" } = Astro.props;
---

<img
  src={`/content/images/${path}`}
  width={width}
  alt={alt}
  loading="lazy"
  decoding="async"
/>
